# public/.htaccess — Mairie de Montjean (53320)

# ----------------------------------------
# Forcer HTTPS
# ----------------------------------------
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ----------------------------------------
# Forcer le www
# ----------------------------------------
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ----------------------------------------
# La Commune
# ----------------------------------------
RewriteRule ^la-commune/?$                    la-commune/presentation.php [L]
RewriteRule ^la-commune/presentation/?$       la-commune/presentation.php [L]
RewriteRule ^la-commune/patrimoine/?$         la-commune/patrimoine.php [L]
RewriteRule ^la-commune/sentiers-communaux/?$ la-commune/sentiers-communaux.php [L]
RewriteRule ^la-commune/aire-de-jeux/?$       la-commune/aire-de-jeux.php [L]
RewriteRule ^la-commune/occupation/?$         la-commune/occupation.php [L]

# ----------------------------------------
# Mairie
# ----------------------------------------
RewriteRule ^mairie/?$                 mairie/equipe.php [L]
RewriteRule ^mairie/equipe/?$          mairie/equipe.php [L]
RewriteRule ^mairie/proces-verbaux/?$  mairie/proces-verbaux.php [L]
RewriteRule ^mairie/arretes/?$         mairie/arretes.php [L]

# ----------------------------------------
# Vie locale
# ----------------------------------------
RewriteRule ^vie-locale/?$               vie-locale/ecole.php [L]
RewriteRule ^vie-locale/ecole/?$         vie-locale/ecole.php [L]
RewriteRule ^vie-locale/periscolaire/?$  vie-locale/periscolaire.php [L]
RewriteRule ^vie-locale/espace/?$        vie-locale/espace.php [L]
RewriteRule ^vie-locale/bibliotheque/?$  vie-locale/bibliotheque.php [L]
RewriteRule ^vie-locale/artisans/?$      vie-locale/artisans.php [L]
RewriteRule ^vie-locale/associations/?$  vie-locale/associations.php [L]
RewriteRule ^vie-locale/utile/?$         vie-locale/utile.php [L]

# ----------------------------------------
# Démarches
# ----------------------------------------
RewriteRule ^demarche/?$                              demarche/urbanisme.php [L]
RewriteRule ^demarche/urbanisme/?$                    demarche/urbanisme.php [L]
RewriteRule ^demarche/recensement-citoyen/?$          demarche/recensement-citoyen.php [L]
RewriteRule ^demarche/recensement-population/?$       demarche/recensement-population.php [L]
RewriteRule ^demarche/argent-de-poche/?$              demarche/argent-de-poche.php [L]
RewriteRule ^demarche/salle-des-fete/?$               demarche/salle-des-fete.php [L]

# ----------------------------------------
# Services
# ----------------------------------------
RewriteRule ^service/?$              service/etat-civil.php [L]
RewriteRule ^service/etat-civil/?$   service/etat-civil.php [L]
RewriteRule ^service/cimetiere/?$    service/cimetiere.php [L]
RewriteRule ^service/election/?$     service/election.php [L]
RewriteRule ^service/dechetterie/?$  service/dechetterie.php [L]

# ----------------------------------------
# Contact
# ----------------------------------------
RewriteRule ^contact/?$ contact.php [L]

# ----------------------------------------
# Masquer l'extension .php
# ----------------------------------------
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]

# ----------------------------------------
# Sécurité : interdire l'accès aux fichiers sensibles
# ----------------------------------------
<FilesMatch "\.(env|log|sql|md|gitignore)$">
    Require all denied
</FilesMatch>

RewriteRule ^includes/ - [F,L]
RewriteRule ^config/ - [F,L]

# ----------------------------------------
# Désactiver le listing des répertoires
# ----------------------------------------
Options -Indexes

# ----------------------------------------
# Pages d'erreur personnalisées
# ----------------------------------------
ErrorDocument 404 /index.php
ErrorDocument 403 /index.php
ErrorDocument 500 /index.php

# ----------------------------------------
# Compression GZIP
# ----------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# ----------------------------------------
# Cache navigateur
# ----------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# ----------------------------------------
# En-têtes de sécurité
# ----------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>